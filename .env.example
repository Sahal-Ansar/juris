# Copy to .env and fill in. Never commit .env.

# Database (PLAN 0.2). Local dev only; docker-compose.yml uses the same defaults.
POSTGRES_USER=juris
POSTGRES_PASSWORD=juris
POSTGRES_DB=juris
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# LLM providers (PLAN 0.3 / 0.4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint (local server, gateway)
OPENAI_BASE_URL=

# Local model through Ollama (free, no key; D-041). Ollama serves an OpenAI-compatible API, so
# every role uses the "openai" provider pointed at it. juris-qwen2.5-7b is qwen2.5:7b with a
# 16k context (scripts/ollama_setup.ps1). To use Claude instead, delete these four lines and
# set ANTHROPIC_API_KEY: the default model is claude-opus-5-5 again.
# JURIS_MODELS__DEFAULT__PROVIDER=openai
# JURIS_MODELS__DEFAULT__NAME=juris-qwen2.5-7b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# Optional overrides of juris.config.Settings (prefix JURIS_, nested with __).
# JURIS_MODELS__DEFAULT__NAME=claude-opus-5-5
# JURIS_BUDGET__MAX_TOKENS_PER_CASE=
# JURIS_LLM_CACHE=read_write

# Where corpus data, runs and the LLM cache go (keep outside cloud-synced folders)
# JURIS_DATA_DIR=C:/juris-data
