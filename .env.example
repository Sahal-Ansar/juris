# Copy to .env and fill in. Never commit .env.

# Database (PLAN 0.2). Local dev only; docker-compose.yml uses the same defaults.
POSTGRES_USER=juris
POSTGRES_PASSWORD=juris
POSTGRES_DB=juris
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM providers (PLAN 0.3 / 0.4)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides of juris.config.Settings (prefix JURIS_, nested with __).
# JURIS_MODELS__DEFAULT__NAME=claude-opus-5-5
# JURIS_BUDGET__MAX_TOKENS_PER_CASE=
# JURIS_LLM_CACHE=read_write
