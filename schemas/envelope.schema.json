{
  "$defs": {
    "Stage": {
      "description": "Pipeline stages S0-S10 (IDEA_final §6).",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7",
        "S8",
        "S9",
        "S10"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Fields shared by every event. Subclasses add ``type`` (a Literal) and ``payload``.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "pattern": "^evt_\\d{6,}$",
      "title": "Event Id",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "seq": {
      "description": "Strictly increasing per run, starting at 1",
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None for run-level events"
    },
    "agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None for events emitted by code",
      "title": "Agent"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "case_id",
    "seq",
    "ts",
    "stage",
    "agent"
  ],
  "title": "Envelope",
  "type": "object"
}
